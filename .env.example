# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/small-web

# NestJS API
PORT=3848
# Comma-separated allowed browser origins (localhost and 127.0.0.1 both needed)
CORS_ORIGIN=http://localhost:3847,http://127.0.0.1:3847

# Next.js frontend (public)
NEXT_PUBLIC_API_URL=http://127.0.0.1:3848/api
